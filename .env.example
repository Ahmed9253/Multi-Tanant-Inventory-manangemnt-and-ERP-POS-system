# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/worknest_pos
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/worknest_pos
MONGODB_URI=mongodb://127.0.0.1:27017/worknest_pos

# Backend server port (Vite proxy must match this)
PORT=4000

# Admin credentials (used for admin login — not stored in database)
ADMIN_EMAIL=admin@worknest.com
ADMIN_PASSWORD=admin123
