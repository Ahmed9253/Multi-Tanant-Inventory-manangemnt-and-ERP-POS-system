# ───────────────────────────────────────────────────────────────────────────
# WorkNest environment variables
#
# Local development : copy this file to `.env` in the same folder.
# Vercel deployment : add each value in
#                     Project → Settings → Environment Variables.
#
# Only variables prefixed with VITE_ are exposed to the browser.
# ───────────────────────────────────────────────────────────────────────────

# ── Backend (Express API / serverless function) ────────────────────────────

# MongoDB connection string.
#   Local  : mongodb://127.0.0.1:27017/worknest_pos
#   Vercel : mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/worknest_pos
MONGODB_URI=mongodb://127.0.0.1:27017/worknest_pos

# Port for the local Express server. Vercel ignores this (serverless).
PORT=4000

# Admin login (validated in code, never stored in the database).
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@worknest.com
ADMIN_PASSWORD=admin123

# Optional. Comma separated list of browser origins allowed to call the API.
#   Local  : leave empty (Vite proxies /api on the same origin)
#   Vercel : leave empty when the frontend and API share a domain, or set the
#            deployed URL, e.g. https://worknest.vercel.app
CLIENT_ORIGIN=

# ── Frontend (Vite) ────────────────────────────────────────────────────────

# Base URL used for every API request.
#   Local  (Vite proxy)  : leave empty
#   Vercel (same origin) : leave empty
#   Split API and UI     : https://your-api.vercel.app
VITE_API_BASE_URL=

# Local dev only. Where `npm run dev` proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
